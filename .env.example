# WhatsApp number used by every CTA on the site, digits only with country code
# (e.g. 5512999999999). Required: the build fails in production when unset.
NEXT_PUBLIC_IN_PHONE_NUMBER=

# Absolute public origin, no trailing slash (e.g. https://refugiodapedrasp.com.br).
# Feeds canonicals, OG tags, robots.txt and sitemap.xml.
# Required: the build fails in production when unset.
NEXT_PUBLIC_SITE_URL=

# Número de registro do Cadastur (cadastro de prestadores de serviços turísticos
# do Ministério do Turismo), exibido na /politica-de-privacidade/.
# OPCIONAL — ao contrário das duas variáveis acima, esta não quebra o build quando
# vazia. Sem valor, a linha do Cadastur simplesmente não é renderizada na página;
# nenhum placeholder do tipo "[a informar]" chega ao HTML publicado.
NEXT_PUBLIC_CADASTUR=

# IndexNow key used to ping Bing/Yandex for fast reindexing (scripts/indexnow-submit.mjs,
# also available as `npm run indexnow`). Only this script reads it — the site build
# does not, so leaving it empty just disables the ping.
#
# The value must equal the basename of the key file already committed under public/.
# This repo ships public/e31c1a12d816eecddab2eb78dd894845.txt, so use:
#   INDEXNOW_KEY=e31c1a12d816eecddab2eb78dd894845
# If you rotate the key, rename that file to match and put the same string inside it.
INDEXNOW_KEY=e31c1a12d816eecddab2eb78dd894845

# Endereço do mapa turístico, que tem site próprio: origem absoluta, sem barra
# no final (ex.: https://mapa.example.com). Lido por src/lib/env.ts (getMapaUrl).
# Os links da /mapa-turistico/, o item "Mapa" do cabeçalho, o link "Mapa
# interativo" do rodapé e os links `mapa:` dos posts do blog (src/lib/posts.ts)
# apontam para ele, e o next.config.ts redireciona
# para lá as URLs que o mapa tinha neste site (/mapa/, /mapa-turistico/hot-stone/,
# /mapa-turistico/pedra-do-bau/, /kit/adesivo/, /relatorio/, /mapa.webmanifest).
# OPCIONAL — vazio não quebra o build: na /mapa-turistico/ os botões para o
# mapa somem e o texto fica, o "Mapa" do cabeçalho e os links dos posts caem
# na /mapa-turistico/, e nenhum redirecionamento é criado.
# Em teste local, o mapa roda em dev em http://localhost:3002.
NEXT_PUBLIC_MAPA_URL=
